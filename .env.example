# Copiar a .env.local y completar. Nunca versionar valores reales.
# Para el demo offline (`npm run demo`) y los tests NO hace falta nada de esto.

# --- LLM (DeepSeek por defecto, API compatible con OpenAI) ---
LLM_PROVIDER=deepseek
LLM_MODEL=
DEEPSEEK_API_KEY=
# Otros proveedores: gemini | groq | cualquier endpoint OpenAI-compatible
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=

# --- Supabase (Postgres + RLS) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Sesión del dashboard y superadmin ---
AUTH_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=
SUPERADMIN_SECRET=

# --- Comportamiento del agente ---
# "cierre" (lleva la venta hasta el pedido confirmado) | "derivar" (informa y pasa a un asesor)
MODO_VENTA=cierre

# --- Worker de WhatsApp (Baileys, no oficial) ---
WA_AUTH_DIR=./.wa-auth
# Número del asesor que recibe el aviso de lead caliente (solo dígitos con prefijo país)
ADMIN_WHATSAPP=
WORKER_URL=
WORKER_TOKEN=

# --- Opcional: ruta base si la app se sirve bajo una subruta ---
# NEXT_PUBLIC_BASE_PATH=

# --- Opcional: notas de voz ---
STT_PROVIDER=groq
KOKORO_URL=
KOKORO_VOICE=
KOKORO_TOKEN=
VOZ_RESPONDER=mirror
VOZ_MAX_CHARS=600

# --- Opcional: cobros de suscripción (Mercado Pago) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BACK_URL=
